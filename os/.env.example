# TIMBI OS — copier en .env (jamais commité). `npm run setup` le crée pour vous.

# sandbox uniquement dans le MVP (production est verrouillée par le code)
TIMBI_MODE=sandbox

# mock = modèle simulé, gratuit, hors-ligne | live = vraie API Claude
LLM_MODE=mock
# ANTHROPIC_API_KEY=            # requis seulement si LLM_MODE=live
TIMBI_MODEL=claude-opus-5-5
# TIMBI_MODEL_HUNTER=claude-opus-5-5
# TIMBI_MODEL_ATLAS=claude-opus-5-5

# Plafonds de dépenses (USD)
BUDGET_PER_RUN_USD=0.75
BUDGET_DAILY_USD=2
BUDGET_MONTHLY_USD=30
# Marge minimale exigée avant chaque appel au modèle
BUDGET_RESERVE_USD=0.10

# Limites d'exécution
MAX_AGENT_ITERATIONS=12
MAX_TASK_ATTEMPTS=3
CIRCUIT_BREAKER_ERRORS=5
APPROVAL_TTL_HOURS=24

# mock = messages écrits dans data/telegram-outbox.log | live = vrai bot
TELEGRAM_MODE=mock
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=

DASHBOARD_PORT=4747
# DASHBOARD_TOKEN est généré par `npm run setup`

DB_PATH=data/timbi-sandbox.db
