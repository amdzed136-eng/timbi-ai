{
  "name": "timbi-os",
  "version": "0.1.0",
  "private": true,
  "description": "TIMBI OS — système d'exploitation interne de TIMBI AI (MVP : ATLAS, HUNTER, approbations Telegram)",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "setup": "node src/cli.ts init",
    "cli": "node src/cli.ts",
    "hunt": "node src/cli.ts hunt",
    "atlas": "node src/cli.ts atlas",
    "start": "node src/daemon.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
